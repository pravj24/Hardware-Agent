{
  "name": "watchermcp",
  "version": "0.1.0",
  "private": true,
  "description": "WatcherMCP operations frontend and hardware-agent workspace",
  "repository": { "type": "git", "url": "https://github.com/pravj24/WatcherMCP.git" },
  "engines": { "node": ">=20" },
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "npm run dev --workspace @watchermcp/frontend",
    "build": "npm run build --workspace @watchermcp/frontend",
    "preview": "npm run preview --workspace @watchermcp/frontend",
    "start": "npm run start --workspace @watchermcp/frontend",
    "test": "npm run test --workspace @watchermcp/frontend",
    "test:python": "python -m unittest discover -s tests -v",
    "test:deploy": "python -m unittest discover -s deploy -p test_*.py -v"
  }
}
