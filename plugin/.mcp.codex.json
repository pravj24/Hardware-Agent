      "args": ["-m", "overwatch", "mcp", "--zone", "fleet"],
      "env_vars": ["WATCHER_MCP_DB"]
    },
    "watcher-records": {
      "command": "python",
      "args": ["-m", "overwatch", "mcp", "--zone", "records"],
