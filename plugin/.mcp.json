{
  "mcpServers": {
    "watcher-fleet": {
      "command": "python",
      "args": ["-m", "overwatch", "mcp", "--zone", "fleet", "--db", "${WATCHER_MCP_DB:-data/overwatch.db}"]
    },
    "watcher-records": {
      "command": "python",
      "args": ["-m", "overwatch", "mcp", "--zone", "records", "--db", "${WATCHER_MCP_DB:-data/overwatch.db}"]
    },
    "watcher-market": {
      "command": "python",
      "args": ["-m", "overwatch", "mcp", "--zone", "market", "--db", "${WATCHER_MCP_DB:-data/overwatch.db}"]
    }
  }
}
