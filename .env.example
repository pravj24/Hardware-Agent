# Backend only. Copy to .env in the working directory or export these variables.
# `python -m overwatch demo` loads .env; existing environment values take precedence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional live supplier discovery; otherwise uses labeled fixture records.
WATCHER_CRUSTDATA_TOKEN=
# Never add Gemini or other service keys to frontend build variables.
